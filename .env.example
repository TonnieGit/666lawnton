# Data source: mock (scraped JSON in data/mock) | wix (live Wix Headless, Phase 2)
DATA_SOURCE=mock
# Mock images: remote (Wix CDN) | local (public/mock-media backups, see spec §6.4)
MOCK_MEDIA=remote
# Phase 2: Wix Headless OAuth client ID
NEXT_PUBLIC_WIX_CLIENT_ID=
# Canonical URLs + metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# true on every preview deployment
NEXT_PUBLIC_NOINDEX=true
